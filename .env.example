# Copier ce fichier en .env puis adapter les valeurs.
# Identifiants de développement uniquement : ne jamais réutiliser en production.

# PostgreSQL
POSTGRES_DB=sps
POSTGRES_USER=sps
POSTGRES_PASSWORD=sps_dev_password
# 5434 pour ne pas entrer en conflit avec les PostgreSQL installés localement (5432 et 5433)
POSTGRES_PORT=5434

# Stockage objet S3 (SeaweedFS)
S3_ACCESS_KEY=sps_admin
S3_SECRET_KEY=sps_dev_password
S3_PORT=8333
# Interface d'administration SeaweedFS (http://localhost:23646, utilisateur "admin")
SEAWEEDFS_ADMIN_PASSWORD=sps_dev_password
SEAWEEDFS_ADMIN_PORT=23646

# Buckets (créés au démarrage par storage/init.sh)
S3_BUCKET_RAW=videos-raw
S3_BUCKET_HLS=videos-hls
S3_BUCKET_IMAGES=images

# JWT (clé HMAC du backend, au moins 32 caractères)
JWT_SECRET=dev-only-jwt-secret-change-me-32-chars-min

# HTTPS local (profil Spring "https") : mot de passe du certificat backend/certs/localhost.p12
SSL_KEYSTORE_PASSWORD=change-me-keystore-password

# RabbitMQ (file des travaux de transcodage). Interface web : http://localhost:15672
RABBITMQ_USER=sps
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
